<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f093fb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f5576c;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="2" dy="2" stdDeviation="3" flood-opacity="0.2"/>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="500" fill="#0a0a0f"/>
  
  <!-- Title -->
  <text x="400" y="40" text-anchor="middle" fill="#fff" font-family="Inter, sans-serif" font-size="24" font-weight="600">Ekonomi Pasca-Pekerjaan</text>
  <text x="400" y="65" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="14">Transformasi Nilai di Era AI</text>
  
  <!-- Left Side: Humans -->
  <rect x="50" y="100" width="200" height="350" rx="15" fill="#1a1a2e" stroke="#667eea" stroke-width="2" filter="url(#shadow)"/>
  <circle cx="150" cy="150" r="40" fill="url(#grad1)" opacity="0.8"/>
  <text x="150" y="210" text-anchor="middle" fill="#fff" font-family="Inter, sans-serif" font-size="16" font-weight="500">Manusia</text>
  <text x="150" y="240" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="12">Kreativitas</text>
  <text x="150" y="260" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="12">Empati</text>
  <text x="150" y="280" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="12">Makna</text>
  <text x="150" y="320" text-anchor="middle" fill="#667eea" font-family="Inter, sans-serif" font-size="11">↓ Berkurang ↓</text>
  <text x="150" y="340" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="11">Produktivitas</text>
  <text x="150" y="360" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="11">Keterampilan</text>
  
  <!-- Center: AI Transition -->
  <rect x="280" y="180" width="240" height="140" rx="10" fill="#16213e" stroke="#f093fb" stroke-width="2" filter="url(#shadow)"/>
  <text x="400" y="210" text-anchor="middle" fill="#f093fb" font-family="Inter, sans-serif" font-size="18" font-weight="600">AI / Mesin</text>
  <text x="400" y="240" text-anchor="middle" fill="#fff" font-family="Inter, sans-serif" font-size="13">Kecepatan ↑</text>
  <text x="400" y="260" text-anchor="middle" fill="#fff" font-family="Inter, sans-serif" font-size="13">Akurasi ↑</text>
  <text x="400" y="280" text-anchor="middle" fill="#fff" font-family="Inter, sans-serif" font-size="13">Biaya ↓</text>
  <text x="400" y="300" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="12">Otonomi ↑</text>
  
  <!-- Right Side: New Economy -->
  <rect x="550" y="100" width="200" height="350" rx="15" fill="#1a1a2e" stroke="#4ade80" stroke-width="2" filter="url(#shadow)"/>
  <circle cx="650" cy="150" r="40" fill="url(#grad2)" opacity="0.8"/>
  <text x="650" y="210" text-anchor="middle" fill="#fff" font-family="Inter, sans-serif" font-size="16" font-weight="500">Ekonomi Baru</text>
  <text x="650" y="240" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="12">UBI?</text>
  <text x="650" y="260" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="12">Pasca-skarcity</text>
  <text x="650" y="280" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="12">Symbiosis</text>
  <text x="650" y="320" text-anchor="middle" fill="#4ade80" font-family="Inter, sans-serif" font-size="11">↑ Bertambah ↑</text>
  <text x="650" y="340" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="11">Meaning</text>
  <text x="650" y="360" text-anchor="middle" fill="#888" font-family="Inter, sans-serif" font-size="11">Koneksi</text>
  
  <!-- Arrows -->
  <path d="M 250 270 L 280 270" stroke="#667eea" stroke-width="2" marker-end="url(#arrowhead)"/>
  <path d="M 520 270 L 550 270" stroke="#4ade80" stroke-width="2" marker-end="url(#arrowhead)"/>
  
  <!-- Arrow marker -->
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#888"/>
    </marker>
  </defs>
  
  <!-- Bottom quote -->
  <text x="400" y="470" text-anchor="middle" fill="#555" font-family="Inter, sans-serif" font-size="12" font-style="italic">"Mesin tidak membenci manusia. Ia hanya lebih baik."</text>
</svg>
